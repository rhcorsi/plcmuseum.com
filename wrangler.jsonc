{
  // Cloudflare Worker serving the static site (dist/) plus the tiny stories API.
  // D1 database ids are identifiers, not secrets (docs/OPEN_SOURCE.md). Secrets via `wrangler secret put`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plcmuseum",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-01-01",
  // No Node APIs are used, so no nodejs_compat: a smaller runtime surface.
  "compatibility_flags": [],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker runs before the binding on every request: it adds the security headers to asset responses too
    // (docs/SECURITY.md 3.1) and answers "/" before the binding would (docs/ARCHITECTURE.md section 7).
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "plcmuseum-stories", "database_id": "58274be7-dc32-4631-8075-3d6c9902f6e9" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_PUBLIC_SITE_KEY"
  },
  // Disabled until Phase 3: the daily retention job ships with the scheduled() handler and POST /api/stories
  // (worker/README.md). A cron without a handler only produces errors.
  // "triggers": { "crons": ["17 3 * * *"] },
  // Workers Logs keep exceptions and the Worker's own console output (none). Invocation logs are off: they would
  // store every request's headers, IP and location for days (docs/SECURITY.md 3.2). env.preview inherits this.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "routes": [
    { "pattern": "plcmuseum.com", "custom_domain": true },
    { "pattern": "www.plcmuseum.com", "custom_domain": true }
  ],
  "env": {
    "preview": {
      "name": "plcmuseum-preview",
      "vars": { "ENVIRONMENT": "preview", "TURNSTILE_SITE_KEY": "REPLACE_WITH_PUBLIC_SITE_KEY" },
      "d1_databases": [
        { "binding": "DB", "database_name": "plcmuseum-stories-preview", "database_id": "5ece5db5-29ad-4964-b67a-873211b7e3a6" }
      ],
      "routes": [{ "pattern": "preview.plcmuseum.com", "custom_domain": true }]
    }
  }
}

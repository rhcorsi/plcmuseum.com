#!/bin/sh
# Install once per clone:  git config core.hooksPath scripts/hooks
# Runs before every commit: secret scan, public-safety check, content validation.
set -e

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner
else
  echo "pre-commit: gitleaks not installed; secret scan skipped locally (CI still runs it). Install: https://github.com/gitleaks/gitleaks"
fi

node scripts/check-public-safety.mjs --staged

# The validator also gates the site illustrations. A pathspec instead of grepping the name list: git quotes
# non-ASCII names in that list ("content/caf\303\251.json"), which a ^content/ pattern would miss.
if ! git diff --cached --quiet -- content src/assets/illustrations; then
  node scripts/validate-content.mjs --quiet
fi

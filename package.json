{
  "name": "plcmuseum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PLC Museum: an open, multilingual visual timeline of PLCs and DCS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhcorsi/plcmuseum.com"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "node scripts/gen-types.mjs --check && astro check && wrangler types worker/worker-configuration.d.ts && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "node scripts/validate-content.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "images:process": "node scripts/images-process.mjs",
    "stories:moderate": "node scripts/stories-moderate.mjs",
    "stories:fetch": "node scripts/stories-fetch.mjs",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:prod": "node scripts/deploy.mjs production"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}

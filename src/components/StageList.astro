---
// Server-rendered stage: the semantic list of exhibits that works without JS and that the CoverFlow island
// (docs/tasks/TASK-001-coverflow-island.md) enhances. Class names, ids and data attributes are the STAGE_HOOKS
// contract in src/islands/contracts.ts: keep them stable, the island selects on them.
import { LANG_TAGS, type Lang } from '../i18n/utils';
import { type ExhibitCard, STAGE_HOOKS } from '../islands/contracts';
import ExhibitVisual from './ExhibitVisual.astro';
import YearLabel from './YearLabel.astro';

interface Props {
  exhibits: ExhibitCard[];
  lang: Lang;
  /** Exhibit the stage starts on; the first one when omitted. */
  initialId?: string;
  /** Accessible name of the list. */
  label: string;
  /** id of the <ol>; the CoverFlow island receives it as listId. */
  id?: string;
  /**
   * A CoverFlow island enhances this list: it then paints as the stage from the first paint on, before the island
   * attaches (STAGE_HOOKS.pending).
   */
  coverflow?: boolean;
}

const { exhibits, lang, initialId = exhibits[0]?.id, label, id = 'stage', coverflow = false } = Astro.props;
---

<ol
  class:list={[STAGE_HOOKS.list, { [STAGE_HOOKS.pending]: coverflow }]}
  id={id}
  data-initial-id={initialId}
  aria-label={label}
>
  {exhibits.map((card) => {
    const ids = {
      link: `stage-link-${card.id}`,
      name: `stage-name-${card.id}`,
      maker: `stage-maker-${card.id}`,
      year: `stage-year-${card.id}`,
      tagline: `stage-tagline-${card.id}`,
    };
    return (
      <li
        class:list={[STAGE_HOOKS.item, { 'is-center': coverflow && card.id === initialId }]}
        id={`stage-item-${card.id}`}
        data-id={card.id}
        data-decade={card.decade}
        data-era={card.era}
        data-year={card.year}
      >
        <span class={STAGE_HOOKS.watermark} aria-hidden="true">
          {card.year}
        </span>
        {/* Named by name, maker and year, described by the tagline: the full card text would make a long link name.
            CoverFlow turns this link into the listbox option, so the option keeps the same name and description. */}
        <a
          class="card"
          id={ids.link}
          href={card.href}
          aria-labelledby={`${ids.name} ${ids.maker} ${ids.year}`}
          aria-describedby={ids.tagline}
        >
          <ExhibitVisual
            card={card}
            lang={lang}
            sizes="(min-width: 48rem) 18rem, 100vw"
            eager={card.id === initialId}
          />
          <span class="text">
            <YearLabel class="year" id={ids.year} lang={lang} year={card.year} precision={card.yearPrecision} />
            <span class="name" id={ids.name}>
              {card.name}
            </span>
            <span class="maker" id={ids.maker}>
              {card.manufacturer}
            </span>
            <span class="tagline" id={ids.tagline} lang={card.textLang === lang ? undefined : LANG_TAGS[card.textLang]}>
              {card.tagline}
            </span>
          </span>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .stage-watermark {
    display: none;
  }

  .stage-list {
    /* The stage's year size: the stage and its first paint (.is-pending) reserve the same room above the cards. */
    --coverflow-watermark-size: clamp(5rem, 15vw, 12rem);

    display: grid;
    gap: var(--space-4);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .card {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-bg-elevated);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition:
      background-color var(--motion-fast) var(--motion-ease),
      box-shadow var(--motion-fast) var(--motion-ease);
  }

  .card:hover {
    background: var(--color-surface-hover);
    box-shadow: var(--shadow-md);
  }

  .text {
    display: grid;
    align-content: center;
    gap: var(--space-1);
  }

  .year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .maker {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .tagline {
    margin-block-start: var(--space-2);
    font-size: var(--text-base);
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .card {
      grid-template-columns: 18rem 1fr;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .stage-list.is-coverflow {
      position: relative;
      isolation: isolate;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-block: calc(var(--coverflow-watermark-size) + var(--space-4)) var(--space-6);
      overflow: hidden;
      perspective: var(--stage-perspective);
      touch-action: pan-y pinch-zoom;
    }

    .is-coverflow .stage-item {
      position: relative;
      grid-area: 1 / 1;
      justify-self: center;
      inline-size: var(--stage-item-width);
      min-inline-size: 0;
      z-index: var(--coverflow-order);
      opacity: 0;
      pointer-events: none;
      transform: translateX(calc(var(--coverflow-offset) * (var(--stage-pitch) + var(--stage-gap))))
        translateZ(calc(var(--coverflow-distance) * var(--stage-depth) * -1))
        rotateY(calc(var(--coverflow-direction) * var(--stage-tilt) * -1)) scale(var(--stage-scale-side));
      transition:
        transform var(--motion-stage) var(--motion-ease-stage),
        opacity var(--motion-stage) var(--motion-ease-stage);
    }

    .is-coverflow .stage-item.is-near {
      opacity: 1;
      pointer-events: auto;
      will-change: transform, opacity;
    }

    .is-coverflow .stage-item.is-center {
      transform: translateX(0) translateZ(0) rotateY(0) scale(1);
    }

    .is-coverflow .stage-item.is-parked {
      visibility: hidden;
      transition: none;
      will-change: auto;
    }

    .is-coverflow .card {
      position: relative;
      block-size: 100%;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      box-shadow: var(--shadow-stage);
      transition: none;
      overflow-wrap: anywhere;
    }

    .is-coverflow .stage-watermark {
      position: absolute;
      display: block;
      inset-inline: -25%;
      inset-block-start: calc((var(--coverflow-watermark-size) + var(--space-4)) * -1);
      font-family: var(--font-numeric);
      font-size: var(--coverflow-watermark-size);
      line-height: 1;
      text-align: center;
      color: var(--color-text-muted);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--motion-stage) var(--motion-ease-stage);
    }

    .is-coverflow .is-center .stage-watermark {
      opacity: 1;
    }

    /* Settle geometry before exposing cards on the first paint, keeping the listbox focusable. The centered card
       keeps showing: on a list painted pending it is already in place, and hiding it would make it blink. */
    .is-coverflow.is-initializing .stage-item:not(.is-center) {
      visibility: hidden;
    }

    .is-coverflow.is-initializing .stage-item,
    .is-coverflow.is-initializing .stage-watermark,
    .is-coverflow .stage-item.is-jumping,
    .is-coverflow .is-jumping .stage-watermark,
    .is-coverflow .is-parked .stage-watermark {
      transition: none;
    }

    .stage-list.is-coverflow:focus-visible {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }

    .is-coverflow:focus-visible .is-center .card {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }
  }

  /* First paint of a list a CoverFlow island is about to enhance (STAGE_HOOKS.pending, removed when it attaches):
     the block geometry of the .is-coverflow rules above, every card stacked in one cell at the stage width, with
     only the card the stage starts on and its year shown. Hydration then changes no size, so nothing below the stage
     moves (layout shift), and the year, often the largest paint, does not wait for the island's code. The same
     declarations as above on purpose: .is-coverflow must not depend on `scripting`, which older browsers do not
     know (they paint the static list first), while without scripting this state must never apply. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .stage-list.is-pending {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-block: calc(var(--coverflow-watermark-size) + var(--space-4)) var(--space-6);
      overflow: hidden;
    }

    .is-pending .stage-item {
      position: relative;
      grid-area: 1 / 1;
      justify-self: center;
      inline-size: var(--stage-item-width);
      min-inline-size: 0;
    }

    .is-pending .stage-item:not(.is-center) {
      visibility: hidden;
    }

    .is-pending .card {
      position: relative;
      block-size: 100%;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      box-shadow: var(--shadow-stage);
      overflow-wrap: anywhere;
    }

    .is-pending .stage-watermark {
      position: absolute;
      display: block;
      inset-inline: -25%;
      inset-block-start: calc((var(--coverflow-watermark-size) + var(--space-4)) * -1);
      font-family: var(--font-numeric);
      font-size: var(--coverflow-watermark-size);
      line-height: 1;
      text-align: center;
      color: var(--color-text-muted);
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>

---
// Server-rendered stage: the semantic list of exhibits that works without JS and that the CoverFlow island
// (docs/tasks/TASK-001-coverflow-island.md) enhances. Class names, ids and data attributes are the STAGE_HOOKS
// contract in src/islands/contracts.ts: keep them stable, the island selects on them.
import { LANG_TAGS, type Lang } from '../i18n/utils';
import { type ExhibitCard, STAGE_HOOKS } from '../islands/contracts';
import ExhibitVisual from './ExhibitVisual.astro';
import YearLabel from './YearLabel.astro';

interface Props {
  exhibits: ExhibitCard[];
  lang: Lang;
  /** Exhibit the stage starts on; the first one when omitted. */
  initialId?: string;
  /** Accessible name of the list. */
  label: string;
  /** id of the <ol>; the CoverFlow island receives it as listId. */
  id?: string;
}

const { exhibits, lang, initialId = exhibits[0]?.id, label, id = 'stage' } = Astro.props;
---

<ol class={STAGE_HOOKS.list} id={id} data-initial-id={initialId} aria-label={label}>
  {exhibits.map((card) => {
    const ids = { name: `stage-name-${card.id}`, year: `stage-year-${card.id}`, tagline: `stage-tagline-${card.id}` };
    return (
      <li
        class={STAGE_HOOKS.item}
        id={`stage-item-${card.id}`}
        data-id={card.id}
        data-decade={card.decade}
        data-era={card.era}
        data-year={card.year}
      >
        <span class="stage-watermark" aria-hidden="true">
          {card.year}
        </span>
        {/* Named by name and year, described by the tagline: the full card text would make a long link name. */}
        <a class="card" href={card.href} aria-labelledby={`${ids.name} ${ids.year}`} aria-describedby={ids.tagline}>
          <ExhibitVisual
            card={card}
            lang={lang}
            sizes="(min-width: 48rem) 18rem, 100vw"
            eager={card.id === initialId}
          />
          <span class="text">
            <YearLabel class="year" id={ids.year} lang={lang} year={card.year} precision={card.yearPrecision} />
            <span class="name" id={ids.name}>
              {card.name}
            </span>
            <span class="maker">{card.manufacturer}</span>
            <span class="tagline" id={ids.tagline} lang={card.textLang === lang ? undefined : LANG_TAGS[card.textLang]}>
              {card.tagline}
            </span>
          </span>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .stage-watermark {
    display: none;
  }

  .stage-list {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .card {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-bg-elevated);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition:
      background-color var(--motion-fast) var(--motion-ease),
      box-shadow var(--motion-fast) var(--motion-ease);
  }

  .card:hover {
    background: var(--color-surface-hover);
    box-shadow: var(--shadow-md);
  }

  .text {
    display: grid;
    align-content: center;
    gap: var(--space-1);
  }

  .year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .maker {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .tagline {
    margin-block-start: var(--space-2);
    font-size: var(--text-base);
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .card {
      grid-template-columns: 18rem 1fr;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .stage-list.is-coverflow {
      position: relative;
      isolation: isolate;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-block: var(--space-8) var(--space-6);
      overflow: hidden;
      perspective: var(--stage-perspective);
      touch-action: pan-y pinch-zoom;
    }

    .is-coverflow .stage-item {
      position: relative;
      grid-area: 1 / 1;
      justify-self: center;
      inline-size: min(70%, 26rem);
      min-inline-size: 0;
      z-index: var(--coverflow-order);
      opacity: 0;
      pointer-events: none;
      transform: translateX(calc(var(--coverflow-offset) * (65% + var(--stage-gap))))
        translateZ(calc(var(--coverflow-distance) * var(--stage-gap) * -1))
        rotateY(calc(var(--coverflow-direction) * var(--stage-tilt) * -1)) scale(var(--stage-scale-side));
      transition:
        transform var(--motion-stage) var(--motion-ease-stage),
        opacity var(--motion-stage) var(--motion-ease-stage);
    }

    .is-coverflow .stage-item.is-near {
      opacity: 1;
      pointer-events: auto;
      will-change: transform, opacity;
    }

    .is-coverflow .stage-item.is-center {
      transform: translateX(0) translateZ(0) rotateY(0) scale(1);
    }

    .is-coverflow .card {
      position: relative;
      block-size: 100%;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      box-shadow: var(--shadow-stage);
      transition: none;
      overflow-wrap: anywhere;
    }

    .is-coverflow .stage-watermark {
      position: absolute;
      display: block;
      inset-inline: -25%;
      inset-block-start: calc(var(--space-8) * -1);
      font-family: var(--font-numeric);
      font-size: clamp(5rem, 15vw, 12rem);
      line-height: 1;
      text-align: center;
      color: var(--color-text-muted);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--motion-stage) var(--motion-ease-stage);
    }

    .is-coverflow .is-center .stage-watermark {
      opacity: 1;
    }

    .stage-list.is-coverflow:focus-visible {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }

    .is-coverflow:focus-visible .is-center .card {
      outline: calc(var(--border-width) * 2) solid var(--color-focus);
      outline-offset: var(--space-1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>

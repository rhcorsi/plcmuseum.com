---
// Related modules veterans remember (CPU variants, chassis, programming cards), as compact pills.
import type { Exhibit } from '../content/types';

interface Props {
  modules: NonNullable<Exhibit['related_modules']>;
}

const { modules } = Astro.props;
---

<ul class="pills">
  {modules.map((related) => (
    <li>
      <span class="label">{related.label}</span>
      {related.year != null && <span class="year">{related.year}</span>}
    </li>
  ))}
</ul>

<style>
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .year {
    /* A long module label must not squeeze the year into two lines (overflow-wrap: anywhere, global.css). */
    flex-shrink: 0;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }
</style>

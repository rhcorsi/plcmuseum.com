---
// Root 404 for paths outside any language prefix: English, with the five language homes to choose from.
import LanguageChooser from '../components/LanguageChooser.astro';
import { t } from '../i18n/utils';
import Base from '../layouts/Base.astro';
---

<Base lang="en" title={t('en', 'notfound.title')} path={null} noindex>
  <main id="main" tabindex="-1">
    <h1>{t('en', 'notfound.title')}</h1>
    <p>{t('en', 'notfound.body')}</p>
    <p>{t('en', 'chooser.title')}</p>
    <LanguageChooser />
  </main>
</Base>

<style>
  main {
    display: grid;
    gap: var(--space-4);
    max-inline-size: 48rem;
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
  }

  p {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.5;
  }
</style>

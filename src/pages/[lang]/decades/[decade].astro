---
// One page per decade and language, all seven decades always built (an empty decade still has a page, so the
// decade navigation never leads to a 404). Its page era is the decade's, with or without exhibits: no stage island
// runs here, and one exhibit's era_theme_override must not reskin the whole decade.
import EmptyState from '../../../components/EmptyState.astro';
import StageList from '../../../components/StageList.astro';
import { getVisibleExhibits } from '../../../content/queries';
import { DECADES } from '../../../content/schemas';
import type { Decade } from '../../../content/types';
import { type Lang, LANG_TAGS, LANGS, localizedPath, t } from '../../../i18n/utils';
import Page from '../../../layouts/Page.astro';
import { eraForDecade } from '../../../lib/era';
import { toExhibitCard } from '../../../lib/exhibit-card';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => DECADES.map((decade) => ({ params: { lang, decade }, props: { lang, decade } })));
}

interface Props {
  lang: Lang;
  decade: Decade;
}

const { lang, decade } = Astro.props;
const cards = (await getVisibleExhibits())
  .filter((exhibit) => exhibit.decade === decade)
  .map((exhibit) => toExhibitCard(exhibit, lang));
const label = t(lang, `decade.${decade}`);
const intro = t(lang, 'decade.intro', { decade: label });
// Lowercase reads right inside sentences ("anos 1980"); alone, as heading and title, it starts with a capital.
const heading = label.charAt(0).toLocaleUpperCase(LANG_TAGS[lang]) + label.slice(1);
---

<Page lang={lang} title={heading} description={intro} path={`/decades/${decade}`} pageEra={eraForDecade(decade)}>
  <section class="intro">
    <h1>{heading}</h1>
    <p>{intro}</p>
  </section>

  {cards.length > 0 ? (
    <StageList exhibits={cards} lang={lang} label={t(lang, 'decade.stage_label', { decade: label })} />
  ) : (
    <EmptyState
      message={t(lang, 'decade.empty')}
      href={localizedPath(lang, '/contribute')}
      cta={t(lang, 'cta.propose')}
    />
  )}
</Page>

<style>
  .intro {
    display: grid;
    gap: var(--space-3);
    margin-block-end: var(--space-6);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1.1;
  }

  p {
    margin: 0;
    max-inline-size: 60ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
</style>

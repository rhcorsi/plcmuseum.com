---
// Privacy notice for what is true today (Phase 0: static pages, no cookies, no forms; the header remembers Era style
// and the language in local storage). The story form brings its full notice with it (docs/SECURITY.md section 3.3);
// update this page in the same change.
import Prose from '../../components/Prose.astro';
import { CONTACT_EMAIL } from '../../components/site';
import { type Lang, LANGS, t } from '../../i18n/utils';
import Page from '../../layouts/Page.astro';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Page lang={lang} title={t(lang, 'privacy.title')} path="/privacy">
  <Prose>
    <h1>{t(lang, 'privacy.title')}</h1>
    <p class="lead">{t(lang, 'privacy.lead')}</p>
    <p>{t(lang, 'privacy.hosting')}</p>
    <p>{t(lang, 'privacy.no_forms')}</p>
    <p>{t(lang, 'privacy.preferences')}</p>
    <p>{t(lang, 'privacy.stories')}</p>
    <p>
      {t(lang, 'privacy.contact')} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  </Prose>
</Page>

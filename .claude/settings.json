{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm preview)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm validate:content)",
      "Bash(pnpm validate:content:*)",
      "Bash(pnpm gen:types)",
      "Bash(pnpm gen:types:*)",
      "Bash(pnpm images:process)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec astro check:*)",
      "Bash(pnpm exec astro sync:*)",
      "Bash(pnpm exec astro build:*)",
      "Bash(pnpm exec astro dev:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(pnpm exec playwright install:*)",
      "Bash(pnpm exec wrangler dev:*)",
      "Bash(pnpm exec wrangler types:*)",
      "Bash(node scripts/*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr:*)",
      "Bash(npx wrangler dev:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pnpm deploy:*)",
      "Bash(pnpm run deploy:*)",
      "Bash(node scripts/deploy.mjs:*)",
      "Bash(pnpm stories:moderate:*)",
      "Bash(pnpm run stories:moderate:*)",
      "Bash(node scripts/stories-moderate.mjs:*)",
      "Bash(wrangler deploy:*)",
      "Bash(wrangler d1:*)",
      "Bash(wrangler secret:*)",
      "Bash(wrangler versions:*)",
      "Bash(wrangler rollback:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler d1:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(npx wrangler versions:*)",
      "Bash(npx wrangler rollback:*)",
      "Bash(pnpm exec wrangler deploy:*)",
      "Bash(pnpm exec wrangler d1:*)",
      "Bash(pnpm exec wrangler secret:*)",
      "Bash(pnpm exec wrangler versions:*)",
      "Bash(pnpm exec wrangler rollback:*)",
      "Bash(pnpm wrangler:*)",
      "Bash(cat .env:*)",
      "Bash(cat .dev.vars:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/post-edit.mjs"
          }
        ]
      }
    ]
  }
}
